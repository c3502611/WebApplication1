@inject WebApplication1.Data.AppDbContext _context
@using WebApplication1.Models
@using WebApplication1.Helpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
    .product-image {
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 0.25rem;
    }
</style>

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        @{
    var user = Context.Session.GetString("User");
    var role = Context.Session.GetString("Role");
    var cart = Context.Session.GetObject<List<WebApplication1.Models.CartItem>>("Cart");
    var cartCount = cart?.Sum(c => c.Quantity) ?? 0;
}


        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Entertainment Guild</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Left side nav -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Categories
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
                                @foreach (var cat in _context.Categories.ToList())
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Search" asp-route-query="@cat.Name">@cat.Name</a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <form class="d-flex mx-2" asp-controller="Home" asp-action="Search" method="get" style="max-width: 750px; width: 100%;">
                            <input class="form-control me-2" type="search" name="query" placeholder="Search products..." />
                            <button class="btn btn-outline-light" type="submit">Search</button>
                        </form>
                    </ul>

                    <!-- Right side nav -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item me-4 position-relative">
                            @{
                                var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                                var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                                var isCartPage = currentController == "Cart" && currentAction == "Index";
                             }

                <a id="cart-link" class="nav-link d-flex align-items-center gap-1" asp-controller="Cart" asp-action="Index">
                        Cart
                        @if (!isCartPage)
                    {
                            if (cartCount > 0)
                        {
                            <span id="cart-count" class="badge rounded-pill bg-danger" 
                            style="min-width: 22px; height: 22px; font-size: 0.75rem; display: flex; align-items: center; justify-content: center;">
                            @cartCount
                            </span>
                        }
                            else
                        {
                            <span id="cart-count" class="badge rounded-pill bg-danger"
                            style="min-width: 22px; height: 22px; font-size: 0.75rem; display: none;">
                            0
                            </span>
                        }
                    }
                </a>



                        </li>

                        @if (!string.IsNullOrEmpty(user))
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-light me-2">Hello, @user!</span>
                            </li>

                            @if (role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Inventory" asp-action="Index">Inventory</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-fill">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <style>
        .nav-item.dropdown:hover .dropdown-menu {
            display: block;
            margin-top: 0;
        }

        .carousel-control-prev-icon {
    background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%23fff' stroke-width='4' viewBox='0 0 24 24'%3E%3Cpolyline points='15 18 9 12 15 6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-size: 100% 100%;
}

.carousel-control-next-icon {
    background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%23fff' stroke-width='4' viewBox='0 0 24 24'%3E%3Cpolyline points='9 18 15 12 9 6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-size: 100% 100%;
}

.carousel-control-prev,
.carousel-control-next {
    width: 50px;
    height: 80px;
    top: 50%;
    transform: translateY(-50%);
}

    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function updateCartCount(count) {
            const cartCountSpan = document.getElementById('cart-count');
            if (!cartCountSpan) return;

            if (count > 0) {
                cartCountSpan.textContent = count;
                cartCountSpan.style.display = 'flex';
            } else {
                cartCountSpan.style.display = 'none';
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
