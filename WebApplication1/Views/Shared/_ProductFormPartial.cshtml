@model WebApplication1.Models.Product

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" required />
</div>
<div class="mb-3">
    <label asp-for="Category" class="form-label"></label>
    <input asp-for="Category" class="form-control" required />
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
</div>
<div class="mb-3">
    <label asp-for="Price" class="form-label"></label>
    <input asp-for="Price" class="form-control" type="number" step="0.01" required />
</div>
<div class="mb-3">
    <label asp-for="StockQuantity" class="form-label"></label>
    <input asp-for="StockQuantity" class="form-control" type="number" required />
</div>
<div class="mb-3">
    <label class="form-label">Upload Product Image</label>
    <input type="file" name="ImageFile" class="form-control" required />
</div>
