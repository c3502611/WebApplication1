@model IEnumerable<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Products";
    var searchQuery = Context.Request.Query["query"].ToString();
}

<div class="container my-5">
    <h2 class="mb-4">Our Products</h2>

    @if (!string.IsNullOrWhiteSpace(searchQuery))
    {
        <h5 class="text-muted">Showing results for "<strong>@searchQuery</strong>"</h5>

    }
        @if (!Model.Any())
        {
            <p class="text-danger">No products matched your search.</p>
        }

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <a asp-action="Product" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text">$@product.Price.ToString("0.00")</p>
                        </div>
                    </a>
                    <div class="card-footer bg-transparent border-0">
                        <a class="btn btn-sm btn-outline-primary w-100" asp-action="Product" asp-route-id="@product.Id">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
