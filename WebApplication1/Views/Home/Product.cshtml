@model WebApplication1.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">
    <div class="row g-4 align-items-start">
        <!-- Image column -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <img src="@Url.Action("GetImage", "Inventory", new { id = Model.Id })" alt="@Model.Name" class="card-img-top img-fluid" />
            </div>
        </div>

        <!-- Info column -->
        <div class="col-md-7">
            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.Category</p>
            <h4 class="text-success">$@Model.Price.ToString("0.00")</h4>
            <p>@Model.Description</p>

            <p>
                <strong>Stock:</strong>
                @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} available" : "Out of stock")
            </p>

            <form method="post" asp-controller="Cart" asp-action="AddToCart">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                 Add to Cart
                </button>
            </form>

            <a class="btn btn-link mt-3" asp-controller="Home" asp-action="Index">← Back to Products</a>
        </div>
    </div>
</div>
