@model WebApplication1.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">
    <div class="row g-4 align-items-start">

        <div class="col-lg-5">
            @if (Model.Images != null && Model.Images.Any(img => img.ImageData != null))
            {
                <div id="productCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                    <div class="carousel-inner">
                        @{
                            var index = 0;
                            foreach (var image in Model.Images)
                            {
                                if (image.ImageData == null || string.IsNullOrEmpty(image.ImageMimeType)) continue;
                                var base64 = Convert.ToBase64String(image.ImageData);
                                var imageSrc = $"data:{image.ImageMimeType};base64,{base64}";
                                var activeClass = index == 0 ? "active" : "";
                                <div class="carousel-item @activeClass">
                                    <img src="@imageSrc"
                                        class="d-block w-100 rounded"
                                        alt="Product image @(index + 1)"
                                        style="height: 400px; width: 100%; object-fit: contain;" />
                                </div>
                                index++;
                            }
                        }
                    </div>

                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>

                    <div class="mt-3 d-flex flex-wrap gap-2 justify-content-center">
                        @{
                            index = 0;
                            foreach (var image in Model.Images)
                            {
                                if (image.ImageData == null || string.IsNullOrEmpty(image.ImageMimeType)) continue;
                                var base64 = Convert.ToBase64String(image.ImageData);
                                var imageSrc = $"data:{image.ImageMimeType};base64,{base64}";
                                <img src="@imageSrc"
                                     class="img-thumbnail"
                                     style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                                     data-bs-target="#productCarousel"
                                     data-bs-slide-to="@index"
                                     aria-current="@(index == 0 ? "true" : "false")"
                                     aria-label="Slide @(index + 1)" />
                                index++;
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center bg-light rounded" style="height: 300px; color: #888;">
                    No Image Available
                </div>
            }
        </div>

        <!-- 2) Product info (33%) -->
        <div class="col-lg-4">
            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.Category</p>
            <h4 class="text-success">$@Model.Price.ToString("0.00")</h4>
            <p>@Model.Description</p>

            @if (Model.StockQuantity == 0)
            {
                <p><strong>Stock:</strong> <span class="text-danger">Out of stock</span></p>
            }
            else if (Model.StockQuantity < 30)
            {
                <p><strong>Stock:</strong> <span class="text-warning">Running out (@Model.StockQuantity left)</span></p>
            }
            else
            {
                <p><strong>Stock:</strong> <span class="text-success">In stock</span></p>
            }

            <form method="post" asp-controller="Cart" asp-action="AddToCart" class="add-to-cart-form mt-3">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                    Add to Cart
                </button>
            </form>
        </div>

        <!-- Recommended products sidebar -->
       <div class="col-lg-3">
    <h5>Recommended Products</h5>
    <div class="list-group">
        @foreach (var recProd in (List<WebApplication1.Models.Product>)ViewBag.RecommendedProducts)
        {
            var firstImg = recProd.Images?.FirstOrDefault();
            string recImgSrc = null;
            if (firstImg != null && firstImg.ImageData != null && !string.IsNullOrEmpty(firstImg.ImageMimeType))
            {
                var base64 = Convert.ToBase64String(firstImg.ImageData);
                recImgSrc = $"data:{firstImg.ImageMimeType};base64,{base64}";
            }

            <a asp-controller="Home" asp-action="Product" asp-route-id="@recProd.Id" class="list-group-item list-group-item-action d-flex align-items-center">
                @if (!string.IsNullOrEmpty(recImgSrc))
                {
                    <img src="@recImgSrc" alt="@recProd.Name" style="width: 60px; height: 60px; object-fit: cover;" class="me-3 rounded" />
                }
                else
                {
                    <div style="width: 60px; height: 60px;" class="bg-secondary me-3 rounded"></div>
                }
                <div>
                    <div class="fw-semibold">@recProd.Name</div>
                    <small class="text-muted">$@recProd.Price.ToString("0.00")</small>
                </div>
            </a>
        }
    </div>
</div>

<!-- Toast Notification Markup -->
<div class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1055">
    <div id="cartToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Product added to cart!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts { 
    <script>
        document.querySelectorAll('.add-to-cart-form, form[asp-action="AddToCart"]').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();

                const formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                       
                        const toastEl = document.getElementById('cartToast');
                        const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                        toast.show();
                        setTimeout(() => toast.hide(), 2000);

                        const cartLink = document.getElementById('cart-link');
                        if (cartLink) {
    let badge = document.getElementById('cart-count');
    if (!badge) {
        badge = document.createElement('span');
        badge.id = 'cart-count';
        badge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger';
        badge.style.minWidth = '22px';
        badge.style.height = '22px';
        badge.style.fontSize = '0.75rem';
        badge.style.display = 'flex';
        badge.style.alignItems = 'center';
        badge.style.justifyContent = 'center';
        cartLink.appendChild(badge);
    }
    badge.textContent = data.cartCount;
    badge.style.display = data.cartCount > 0 ? 'flex' : 'none';
}
                    } else {
                        console.error('Add to cart failed:', data.message);
                    }
                })
                .catch(err => {
                    console.error('Add to cart failed:', err);
                });
            });
        });
    </script>

    <style>
        
        .add-to-cart-form, 
        .add-to-cart-form button {
            all: unset; 
            display: inline-block;
            padding: 0.5rem 1rem;
            background-color: #0d6efd;
            color: white;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            text-align: center;
            user-select: none;
        }

        .add-to-cart-form button:disabled {
            background-color: #6c757d;
            cursor: not-allowed;
        }
    </style>
}
