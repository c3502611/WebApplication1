@model WebApplication1.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row my-5">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" />
    </div>

    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.Category</p>
        <h4 class="text-success mb-3">$@Model.Price.ToString("0.00")</h4>
        <p>@Model.Description</p>

        <p>
            <strong>Stock:</strong> 
            @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} available" : "Out of stock")
        </p>

        <form method="post" asp-controller="Cart" asp-action="AddToCart">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                Add to Cart
            </button>
        </form>

        <a class="btn btn-link mt-3" asp-controller="Home" asp-action="Index">← Back to Products</a>
    </div>
</div>
