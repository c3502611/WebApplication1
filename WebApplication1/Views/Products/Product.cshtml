@model WebApplication1.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row my-5">
    <div class="col-md-5">
        @{
            var firstImage = Model.Images?.FirstOrDefault();
            if (firstImage != null && firstImage.ImageData != null && !string.IsNullOrEmpty(firstImage.ImageMimeType))
            {
                var base64 = Convert.ToBase64String(firstImage.ImageData);
                var imgSrc = $"data:{firstImage.ImageMimeType};base64,{base64}";
                <img src="@imgSrc" alt="@Model.Name" class="img-fluid rounded" />
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center bg-light rounded" 
                     style="height: 300px; color: #888;">
                    No Image Available
                </div>
            }
        }
    </div>

    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.Category</p>
        <h4 class="text-success mb-3">$@Model.Price.ToString("0.00")</h4>
        <p>@Model.Description</p>

      @if (Model.StockQuantity == 0)
{
    <p><strong>Stock:</strong> <span class="text-danger">Unavailable</span></p>
}
else if (Model.StockQuantity < 30)
{
    <p><strong>Stock:</strong> <span class="text-warning">Running out: @Model.StockQuantity left</span></p>
}


        <form method="post" asp-controller="Cart" asp-action="AddToCart">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                Add to Cart
            </button>
        </form>

        <a class="btn btn-link mt-3" asp-controller="Home" asp-action="Index">← Back to Products</a>
    </div>
</div>
