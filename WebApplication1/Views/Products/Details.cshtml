@model WebApplication1.Models.Product

<h2>@Model.Name</h2>

<div class="row">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" class="img-fluid" />
    </div>
    <div class="col-md-7">
        <h4 class="text-muted">$@Model.Price</h4>
        <p>@Model.Description</p>
        <p><strong>Category:</strong> @Model.Category</p>
        <p><strong>Stock:</strong> @Model.StockQuantity</p>
        <a asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" class="btn btn-success">Add to Cart</a>
    </div>
</div>
