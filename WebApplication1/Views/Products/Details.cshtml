@model WebApplication1.Models.Product

<h2>@Model.Name</h2>

<div class="row">
    <div class="col-md-5">
        @{
            var firstImage = Model.Images?.FirstOrDefault();
        }
        @if (firstImage != null && firstImage.ImageData != null && !string.IsNullOrEmpty(firstImage.ImageMimeType))
        {
            var base64 = Convert.ToBase64String(firstImage.ImageData);
            var imgSrc = $"data:{firstImage.ImageMimeType};base64,{base64}";
            <img src="@imgSrc" class="img-fluid" alt="@Model.Name" />
        }
        else
        {
            <span class="text-muted">No image available</span>
        }
    </div>
    <div class="col-md-7">
        <h4 class="text-muted">$@Model.Price.ToString("0.00")</h4>
        <p>@Model.Description</p>
        <p><strong>Category:</strong> @Model.Category</p>
       <p>
    <strong>Stock:</strong>
    @if (Model.StockQuantity == 0)
    {
        <span class="text-danger">Unavailable</span>
    }
    else if (Model.StockQuantity < 30)
    {
        <span class="text-warning">Running out: @Model.StockQuantity left</span>
    }
</p>

        <form asp-controller="Cart" asp-action="AddToCart" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button type="submit" class="btn btn-success" @(Model.StockQuantity <= 0 ? "disabled" : "")>Add to Cart</button>
        </form>
    </div>
</div>
