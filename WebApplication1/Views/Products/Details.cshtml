@page
@model Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>@Model.Name</h2>
<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" class="img-fluid" />
    </div>
    <div class="col-md-6">
        <h3>$@Model.Price</h3>
        <p>@Model.Description</p>
        <p>In stock: @Model.StockQuantity</p>
        <a href="#" class="btn btn-success">Add to Cart</a>
        <a asp-action="Index" asp-controller="Products" class="btn btn-secondary">Back to Products</a>
    </div>
</div>