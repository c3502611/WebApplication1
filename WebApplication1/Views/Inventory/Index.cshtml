@model IEnumerable<WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Inventory Management";
}

<h2 class="my-4">Inventory Management</h2>

<a class="btn btn-success mb-3" asp-controller="Inventory" asp-action="Add" disabled>+ Add New Product</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th class="text-end">Price</th>
            <th class="text-end">Stock</th>
            <th>Image</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Category</td>
            <td class="text-end">$@product.Price.ToString("0.00")</td>
            <td class="text-end">@product.StockQuantity</td>
            <td>
                <img src="@product.ImageUrl" alt="@product.Name" style="height: 50px;" />
            </td>
            <td class="text-center">
                <a class="btn btn-sm btn-outline-warning me-1" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
            </td>

        </tr>
    }
    </tbody>
</table>