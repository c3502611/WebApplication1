@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Inventory";
}

<h2>Inventory Management</h2>

<a asp-action="Add" class="btn btn-success mb-3">Add New Product</a>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price ($)</th>
            <th>Stock</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            var firstImage = product.Images?.FirstOrDefault();
            <tr>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
                <td>
                    @if (firstImage != null && firstImage.ImageData != null && !string.IsNullOrEmpty(firstImage.ImageMimeType))
                    {
                        var base64 = Convert.ToBase64String(firstImage.ImageData);
                        var imgSrc = $"data:{firstImage.ImageMimeType};base64,{base64}";
                        <img src="@imgSrc" alt="Product Image" style="max-width: 60px; max-height: 60px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted">No image</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
